# Base MySQL dediee a Trankyl Academy (base distincte de trankyl_nodejs)
# Format SQLAlchemy : mysql+pymysql://user:password@host:3306/trankyl_academy
DATABASE_URL=mysql+pymysql://trankyln_academy_user:changeme@mtl201.greengeeks.net:3306/trankyln_academy

# Secret utilise pour signer les JWT (apprenants et admins). A generer avec: openssl rand -hex 32
SECRET_KEY=changeme
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Origine(s) autorisee(s) a appeler l'API : le site trankyl-academy-content en PROD
CORS_ORIGINS=https://academy.trankyl.com

# Cle Gemini (Google AI Studio) pour l'assistant IA de matching. Sans cette cle,
# chat_with_ai() retombe sur une reponse locale par mots-cles.
GEMINI_API_KEY=

# Cloudinary — memes identifiants que trankyl_backend_nodejs, upload NON SIGNE.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
