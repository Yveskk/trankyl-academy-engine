# Base MySQL dediee a Trankyl Academy (base distincte de trankyl_nodejs)
# Format SQLAlchemy : mysql+pymysql://user:password@host:3306/trankyl_academy
DATABASE_URL=mysql+pymysql://trankyln_academy_user:changeme@mtl201.greengeeks.net:3306/trankyl_academy

# Secret utilise pour signer les JWT (apprenants et admins). A generer avec: openssl rand -hex 32
SECRET_KEY=changeme
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Origines autorisees a appeler l'API (site SvelteKit). Plusieurs ports listes
# car Vite bascule sur 5174, 5175... si 5173 est deja occupe.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Cle Gemini (Google AI Studio) pour l'assistant IA de matching (/matching/chat,
# /matching/chat/sessions/...). Sans cette cle, chat_with_ai() retombe sur une
# reponse locale par mots-cles (_local_matching_response).
GEMINI_API_KEY=

# Cloudinary — memes identifiants que trankyl_backend_nodejs (voir son .env),
# pour que les images uploadees vivent dans le meme compte/cloud. Upload NON
# SIGNE uniquement (comme le backend Node) : pas besoin de API_KEY/API_SECRET,
# juste le cloud name et un upload preset configure "unsigned" cote dashboard
# Cloudinary. Sans ces variables, l'upload d'image d'article de blog echoue.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# Mailjet (email) + AfrikSMS (SMS) — memes identifiants que trankyl_backend_nodejs
# (voir son .env), pour l'envoi des codes OTP de reinitialisation de mot de
# passe (/auth/forgot-password, /auth/verify-otp, /auth/reset-password).
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
SENDER_EMAIL=
MAILJET_FROM_NAME=Trankyl
AFRIKSMS_API_KEY=
AFRIKSMS_CLIENT_ID=
AFRIKSMS_SENDER_ID=
AFRIKSMS_API_URL=https://api.afriksms.com/api/web/web_v1/outbounds/send
