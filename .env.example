# Base MySQL dediee a Trankyl Academy (base distincte de trankyl_nodejs)
# Format SQLAlchemy : mysql+pymysql://user:password@host:3306/trankyl_academy
DATABASE_URL=mysql+pymysql://trankyln_academy_user:changeme@mtl201.greengeeks.net:3306/trankyl_academy

# Secret utilise pour signer les JWT (apprenants et admins). A generer avec: openssl rand -hex 32
SECRET_KEY=changeme
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Origines autorisees a appeler l'API (site SvelteKit). Plusieurs ports listes
# car Vite bascule sur 5174, 5175... si 5173 est deja occupe.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Cle Gemini (Google AI Studio) pour l'assistante IA de matching (/matching/chat,
# /matching/chat/sessions/...). Sans cette cle, chat_with_ai() retombe sur une
# reponse locale par mots-cles (_local_matching_response).
GEMINI_API_KEY=

# Cloudinary — memes identifiants que trankyl_backend_nodejs (voir son .env),
# pour que les images uploadees vivent dans le meme compte/cloud. Upload NON
# SIGNE uniquement (comme le backend Node) : pas besoin de API_KEY/API_SECRET,
# juste le cloud name et un upload preset configure "unsigned" cote dashboard
# Cloudinary. Sans ces variables, l'upload d'image d'article de blog echoue.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# Mailjet (email) + AfrikSMS (SMS) — memes identifiants que trankyl_backend_nodejs
# (voir son .env), pour l'envoi des codes OTP de reinitialisation de mot de
# passe (/auth/forgot-password, /auth/verify-otp, /auth/reset-password).
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
SENDER_EMAIL=
MAILJET_FROM_NAME=Trankyl
AFRIKSMS_API_KEY=
AFRIKSMS_CLIENT_ID=
AFRIKSMS_SENDER_ID=
AFRIKSMS_API_URL=https://api.afriksms.com/api/web/web_v1/outbounds/send

# Base des images relatives du catalogue Trankyl (ex. uploads/subcategory/x.jpeg)
MEDIA_BASE_URL=https://trankyl.com/
# Duree de vie du cache memoire de GET /api/v1/home (secondes)
HOME_CACHE_TTL_SECONDS=60

# URL publique du site (liens de partage des profils) et fuseau local (0 = Togo/Cote d'Ivoire, 1 = Benin)
PUBLIC_SITE_URL=https://trankyl.com
LOCAL_UTC_OFFSET_HOURS=0

# --- Verification par code (inscription, connexion, mot de passe oublie) ------------
# WhatsApp Cloud API (modele Meta approuve "otp_verification") — memes valeurs que trankyl_backend_nodejs
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_OTP_TEMPLATE=otp_verification
# log = les codes sont ecrits dans la console du serveur, rien n'est envoye (dev) ; live = envoi reel
OTP_DELIVERY_MODE=log
# Adresse(s) qui recoivent l'alerte « Nouvelle reservation » (separees par des virgules). Vide = pas d'alerte admin.
ADMIN_EMAIL=
# off (defaut : mot de passe correct = connexion directe) | new_device | always  — quand demander un code a la connexion
LOGIN_VERIFICATION_POLICY=off
# Indicatifs autorises pour les envois WhatsApp/SMS (anti-fraude "SMS pumping"), separes par des virgules
OTP_ALLOWED_DIAL_CODES=228,229,225,223,237

# A activer UNIQUEMENT derriere un reverse proxy de confiance (lecture de X-Forwarded-For pour les limites par IP)
TRUST_PROXY_HEADERS=false

# Paiement en ligne SEMOA — memes valeurs que trankyl_backend_nodejs (voir son .env).
SEMOA_API_KEY_PROD=
SEMOA_LOGIN_PROD=
SEMOA_API_REFERENCE_PROD=
# URL publique du webhook de ce serveur : https://<api-academy>/api/v1/payments/semoa-webhook (vide en local)
SEMOA_CALLBACK_URL=
